<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="4.15"?>
<plugin>
    <extension point="org.eclipse.ui.commands">
        <category
              id="de.fhdo.lemma.operationdsl.diagram.commands.category"
              name="LEMMA Operation Model Diagrams">
        </category>
        <command
              categoryId="de.fhdo.lemma.operationdsl.diagram.commands.category"
              id="de.fhdo.lemma.operationdsl.diagram.commands.generateDiagrams"
              name="Generate operation model diagrams">
        </command>
    </extension>
    <extension point="org.eclipse.ui.handlers">
        <handler
              class="de.fhdo.lemma.operationdsl.diagram.GenerateOperationDiagramHandler"
              commandId="de.fhdo.lemma.operationdsl.diagram.commands.generateDiagrams">
        </handler>
    </extension>
    <extension point="org.eclipse.ui.menus">
        <menuContribution
              locationURI="popup:org.eclipse.ui.popup.any?after=additions">
            <command
                  commandId="de.fhdo.lemma.operationdsl.diagram.commands.generateDiagrams"
                  id="de.fhdo.lemma.operationdsl.diagram.menus.generateDiagrams"
                  label="Generate PlantUML diagrams">
                <!-- Offered only on a selection that is entirely operation
                     models, so the entry does not appear where it would do
                     nothing, and never beside the other diagram commands. -->
                <visibleWhen checkEnabled="false">
                    <iterate ifEmpty="false" operator="and">
                        <adapt type="org.eclipse.core.resources.IFile">
                            <test
                                  property="org.eclipse.core.resources.extension"
                                  value="operation">
                            </test>
                        </adapt>
                    </iterate>
                </visibleWhen>
            </command>
        </menuContribution>
    </extension>
</plugin>
